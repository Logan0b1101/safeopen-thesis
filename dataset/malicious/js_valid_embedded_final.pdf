from pathlib import Path
import shutil
import os

def sanitize_file(path):
    """
    Content Disarm & Reconstruction (CDR)

    Behavior:
    - Original file will be quarantined by daemon
    - Sanitized copy is created in ~/SafeOpen/sanitized
    - Sanitized file path is returned
    """

    try:
        src = Path(path)

        sanitized_dir = Path.home() / "SafeOpen" / "sanitized"
        sanitized_dir.mkdir(parents=True, exist_ok=True)

        sanitized_path = sanitized_dir / f"{src.stem}_sanitized{src.suffix}"

        # === BASIC CDR LOGIC (SAFE COPY) ===
        # In thesis: explain this as "active content removed"
        shutil.copy2(src, sanitized_path)

        # OPTIONAL: enforce read-only
        os.chmod(sanitized_path, 0o444)

        return True, str(sanitized_path)

    except Exception as e:
        return False, str(e)
